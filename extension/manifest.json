{
  "manifest_version": 3,
  "name": "Fetchy Integration",
  "version": "0.2.0",
  "description": "Send downloads and links from your browser to the Fetchy download manager.",
  "permissions": [
    "downloads",
    "scripting",
    "contextMenus",
    "cookies",
    "storage",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fetchy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fetchy@fetchy.dev",
      "strict_min_version": "115.0"
    }
  }
}
